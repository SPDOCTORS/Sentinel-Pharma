# SentinelPharma Server Environment Variables
# =========================================
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Connection
MONGODB_URL=mongodb://localhost:27017/sentinelpharma

# CORS - Frontend URL (comma-separated or single URL; strictly enforced in production)
CLIENT_URL=http://localhost:5173

# AI Engine Connection (FastAPI host, required in production)
AI_ENGINE_URL=http://localhost:8002

# Shared credential for Express -> FastAPI internal requests. Set a unique long secret.
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-secret

# Redis is required in production for OTP challenges and token revocation.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-long-random-secret

# Production requires a long random secret for JWT signing (AUTH_TOKEN_SECRET).
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_SECONDS=43200

# OTP Configuration
AUTH_EXPOSE_OTP_PREVIEW=false
AUTH_OTP_MEMORY_FALLBACK=true
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5

# Logging
LOG_LEVEL=info

