# SentinelPharma Server Environment Variables
# =========================================
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS - Frontend URL
CLIENT_URL=http://localhost:5173

# AI Engine Connection
AI_ENGINE_URL=http://localhost:8000
# Shared credential for Express -> FastAPI internal requests. Set a unique secret.
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-secret

# Redis is required in production for OTP challenges and token revocation.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-long-random-secret

# Production must set a unique JWT signing secret.
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
# OTP previews are disabled unless explicitly enabled for local development.
AUTH_EXPOSE_OTP_PREVIEW=false

# Logging
LOG_LEVEL=info
