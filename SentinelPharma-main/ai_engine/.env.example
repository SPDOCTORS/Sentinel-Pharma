# SentinelPharma AI Engine Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# Application
DEBUG=false
DEMO_MODE=false
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
# Must match the server INTERNAL_SERVICE_TOKEN. Keep FastAPI internal-only in production.
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-secret

# PubMed E-utilities. NCBI_EMAIL identifies this client; API key is optional for low-volume use.
NCBI_TOOL_NAME=sentinelpharma
NCBI_EMAIL=researcher@example.com
NCBI_API_KEY=
PUBMED_TIMEOUT_SECONDS=10
PUBMED_MAX_RESULTS=50

# ClinicalTrials.gov v2 retrieval
CLINICAL_TRIALS_TIMEOUT_SECONDS=10
CLINICAL_TRIALS_MAX_RESULTS=50

# Google Gemini (Cloud Mode)
# Get API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_ENABLED=true

# Local Model (Secure Mode)
LOCAL_MODEL_PATH=/models/llama-3-8b
LOCAL_MODEL_NAME=llama-3-8b

# Enable/Disable Modes
CLOUD_ENABLED=true
LOCAL_ENABLED=true

# Default LLM Provider
# Options: gemini, ollama
DEFAULT_LLM_PROVIDER=gemini

# Node.js Backend
NODE_BACKEND_URL=http://localhost:3001

# Neo4j Knowledge Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
